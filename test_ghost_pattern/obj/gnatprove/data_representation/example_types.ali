V "GNAT Lib v15"
A -gnatA
A -gnat2022
A -gnatwa
A -gnatwe
A -gnaty3
A -gnatR2js
A -gnatws
A -gnatis
A -mmacosx-version-min=14.0
A -mcpu=apple-m1
A -mlittle-endian
A -mabi=lp64
A -fPIC
P ZX

RN
RV NO_IMPLEMENTATION_ASPECT_SPECIFICATIONS
RV NO_IMPLEMENTATION_PRAGMAS

U example_types%s	example_types.ads	fb024025 NE OO PK

D example_types.ads	20251017151055 fb024025 example_types%s
D system.ads		20251009152241 70765b54 system%s
G a e
G c Z s s [counterIP example_types 4 9 none]
X 1 example_types.ads
1K9*Example_Types 9l5 9e18
4R9*Counter 8e6
5i7*Value{natural}
6i7*Max{natural}

