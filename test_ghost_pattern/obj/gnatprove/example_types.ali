V "GNAT Lib v15"
A -x
A ada
A -gnatA
A -gnat2022
A -gnatwa
A -gnatwe
A -gnaty3
A -gnatc
A -gnatis
P GP

RN
RV NO_IMPLEMENTATION_ASPECT_SPECIFICATIONS
RV NO_IMPLEMENTATION_PRAGMAS
RV NO_ELABORATION_CODE

U example_types%s	example_types.ads	fb024025 OO PK

D example_types.ads	20251017151055 fb024025 example_types%s
D system.ads		20251009152241 70765b54 system%s
G a Z
X 1 example_types.ads
1K9*Example_Types 9l5 9e18
4R9*Counter 8e6
5i7*Value{natural}
6i7*Max{natural}

QQ SPARKVERSION FSF 15.0
GG EK_DIRECT_CALLS example_types 0
GG EK_PROOF_DEPENDENCIES example_types 0
GG EK_GLOBALS example_types local FALSE E_PACKAGE TRUE ORIGIN_FLOW 0 proper_proof_in 0 proper_input 0 proper_output 0 refined_proof_in 0 refined_input 0 refined_output 0 initializes 0 refined_initializes 0 calls_proof 0 calls 0 calls_conditional 0 local_packages 0 local_var 0 TRUE FALSE FALSE FALSE FALSE ENTRY_CALLS 0 SUSPENDS_ON 0 UNSYNCH_ACCESSES 0 LOCKS 0
GG EK_FLOW_SCOPE example_types__counterPredicate FALSE FALSE FALSE FALSE TRUE example_types VISIBLE_PART
GG EK_FLOW_SCOPE example_types TRUE FALSE FALSE FALSE FALSE __standard
GG EK_END_MARKER
