V "GNAT Lib v15"
A -gnatA
A -gnat2022
A -gnatwa
A -gnatwe
A -gnaty3
A -mmacosx-version-min=14.0
A -mcpu=apple-m1
A -mlittle-endian
A -mabi=lp64
A -fPIC
P ZX

RN
RV NO_IMPLEMENTATION_ASPECT_SPECIFICATIONS
RV NO_IMPLEMENTATION_PRAGMAS

U example%b		example.adb		cb89e81e NE OO PK

U example%s		example.ads		dd46cc0a EE NE OO PK
W example_types%s	example_types.ads	example_types.ali

D example.ads		20251017151102 afd8c42e example%s
D example.adb		20251017151125 64512c30 example%b
D example_ghost.ads	20251017151109 899c4801 example_ghost%s
D example_types.ads	20251017151055 fb024025 example_types%s
D system.ads		20250419085653 70765b54 system%s
G a e
G c Z s b [create example 7 13 none]
G c Z s b [increment example 10 14 none]
X 1 example.ads
4K9*Example 14l5 14e12 2|1b14 13l5 13t12
7V13*Create{4|4R9} 7>21 8r43 2|4b13 7l8 7t14
7i21 Max{natural} 2|4b21 6r34
10U14*Increment 10=25 2|9b14 12l8 12t17
10r25 C{4|4R9} 12r16 12r26 13r47 13r54 2|9b25 11m7 11r18
X 4 example_types.ads
1K9*Example_Types 1|1w6 1r25 4|9e18
4R9*Counter 1|7r43 10r36 2|4r43 9r36 4|8e6
5i7*Value{natural} 1|12r18 2|6m15 11m9 11r20
6i7*Max{natural} 1|12r28 2|6m27

