project Test is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnaty3");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--prover=cvc5");
   end Prove;
end Test;
