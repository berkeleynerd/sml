with "sml.gpr";

project Test_Parser is

   for Source_Dirs use ("test/");
   for Object_Dir use "obj/test";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";

   for Main use ("test_parser.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnatwe", "-gnat2022");
   end Compiler;

   package Builder is
      for Executable ("test_parser.adb") use "test_parser";
   end Builder;

   package Linker is
      for Linker_Options use (
         "-L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib",
         "-Wl,-stack_size,0x2000000");  -- 32MB stack for tests
   end Linker;

end Test_Parser;
