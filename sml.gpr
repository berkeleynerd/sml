with "config/sml_config.gpr";
project Sml is

   for Library_Name use "Sml";
   for Library_Version use Project'Library_Name & ".so." & Sml_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Sml_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   for Library_Interface use ("SML", "SML.DOM", "SML.DOM.Parser", "SML.UTF8", "SML.Entities", "SML.Memory_Model");

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("SML_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;
   for Library_Standalone use "standard";

   package Compiler is
      for Default_Switches ("Ada") use Sml_Config.Ada_Compiler_Switches;
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use
         ("--level=4",
          "--warnings=continue",
          "--report=all",
          "--mode=all",
          "--prover=cvc5,z3,altergo",
          "--timeout=60",
          "--memlimit=0",
          "--proof-warnings=off",
          "--counterexamples=on");
      for Proof_Dir use "proof";
   end Prove;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Sml;
