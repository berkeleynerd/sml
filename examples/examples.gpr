with "../sml.gpr";
with "../sml_io.gpr";

project Examples is

   for Source_Dirs use (".");
   for Object_Dir use "../obj/examples";
   for Exec_Dir use "../bin";
   for Create_Missing_Dirs use "True";

   for Main use ("example_basic_dom.adb",
                 "example_schema_validation.adb",
                 "test_schema_loader.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnatwe", "-gnat2022");
   end Compiler;

   package Builder is
      for Executable ("example_basic_dom.adb") use "example_basic_dom";
      for Executable ("example_schema_validation.adb") 
        use "example_schema_validation";
      for Executable ("test_schema_loader.adb") use "test_schema_loader";
   end Builder;

   package Linker is
      for Linker_Options use (
         "-L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib",
         "-Wl,-stack_size,0x2000000");  -- 32MB stack for examples
   end Linker;

end Examples;
