with "../sml.gpr";

project Test_All is

   for Source_Dirs use (".");
   for Object_Dir use "../obj/test/";
   for Exec_Dir use "../bin/";
   for Create_Missing_Dirs use "True";

   for Main use ("test_all.adb");

   package Compiler is
      for Default_Switches ("Ada") use
         ("-gnat2022",      --  Ada 2022 mode
          "-gnatwa",        --  All warnings
          "-gnatwe",        --  Warnings as errors
          "-gnatyM120",     --  Max line length
          "-gnaty3",        --  Indentation
          "-gnatygO",       --  Subprogram ordering
          "-gnatyB",        --  Boolean operators
          "-gnatyt");       --  Token spacing
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");  --  Symbolic traceback
   end Binder;

   package Linker is
      for Linker_Options use (
         "-L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib",
         "-Wl,-stack_size,0x2000000");  --  32MB stack for combined tests
   end Linker;

end Test_All;

