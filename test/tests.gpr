with "../sml.gpr";
with "../sml_io.gpr";

project Tests is

   for Source_Dirs use (".");
   for Object_Dir use "../obj/test";
   for Exec_Dir use "../bin";
   for Create_Missing_Dirs use "True";
   
   for Main use ("test_parser.adb", 
                 "test_io.adb", 
                 "test_schema.adb");

   package Compiler is
      for Default_Switches ("Ada") use
         ("-gnat2022",      --  Ada 2022 mode
          "-gnatwa",        --  All warnings
          "-gnatwe",        --  Warnings as errors
          "-gnatyM120",     --  Max line length
          "-gnaty3",        --  Indentation
          "-gnatygO",       --  Subprogram ordering
          "-gnatyB",        --  Boolean operators
          "-gnatyt");       --  Token spacing
   end Compiler;

   package Builder is
      for Executable ("test_parser.adb") use "test-parser";
      for Executable ("test_io.adb") use "test-io";
      for Executable ("test_schema.adb") use "test-schema";
   end Builder;

   package Binder is
      for Switches ("Ada") use ("-Es");  --  Symbolic traceback
   end Binder;

   package Linker is
      for Linker_Options use (
         "-L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib",
         "-Wl,-stack_size,0x8000000");  -- 128MB stack
   end Linker;

end Tests;
