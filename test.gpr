with "sml.gpr";

project Test is

   for Source_Dirs use ("test/");
   for Object_Dir use "obj/test";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";

   for Main use ("test_parser.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnatwe");
   end Compiler;

   package Builder is
      for Executable ("test_parser.adb") use "test_parser";
   end Builder;

end Test;
