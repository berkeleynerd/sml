with "sml.gpr";

project Examples is

   for Source_Dirs use ("examples/");
   for Object_Dir use "obj/examples";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";

   for Main use ("sml_example.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnatwe", "-gnat2022");
   end Compiler;

   package Builder is
      for Executable ("sml_example.adb") use "sml_example";
   end Builder;

   package Linker is
      for Linker_Options use (
         "-L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib",
         "-Wl,-stack_size,0x2000000");  -- 32MB stack for examples
   end Linker;

end Examples;
