with "config/sml_config.gpr";
with "sml.gpr";

project SML_IO is

   for Library_Name use "SML_IO";
   for Library_Version use Project'Library_Name & ".so." & Sml_Config.Crate_Version;

   for Source_Dirs use ("util/");
   for Object_Dir use "obj/io_" & Sml_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib/io";

   for Library_Interface use ("SML.IO");

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("SML_IO_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;
   for Library_Standalone use "standard";

   package Compiler is
      for Default_Switches ("Ada") use Sml_Config.Ada_Compiler_Switches;
   end Compiler;

   package Prove is
      --  Verify package spec only (body is SPARK_Mode => Off)
      for Proof_Switches ("Ada") use
        ("--mode=flow",           -- Flow analysis only
         "--warnings=continue",
         "--report=all");
      for Proof_Dir use "proof/io";
   end Prove;

   package Binder is
      for Switches ("Ada") use ("-Es");  --  Symbolic traceback
   end Binder;

   package Linker is
      for Linker_Options use (
         "-L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib");
   end Linker;

end SML_IO;
